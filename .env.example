# ---------------------------------------------------------------------------
# PUBLIC CONFIGURATION ONLY.
#
# Everything in this file is compiled into the extension bundle and is readable
# by anyone who installs it. Never put a server secret here:
#   OPENAI_API_KEY, ANTHROPIC_API_KEY, STRIPE_SECRET_KEY,
#   SUPABASE_SERVICE_ROLE_KEY, ...
# Those belong to a backend that this extension talks to, not to the extension.
#
# Every variable below is OPTIONAL. The extension is local-first: copy this file
# to `.env`, leave it untouched, and `bun dev` will still work.
# ---------------------------------------------------------------------------

# development | test | production
VITE_APP_ENV="development"

# Supabase — authentication only (cloud-eligible). Leave blank to disable.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# OpenPanel — anonymous product analytics (cloud-eligible). Leave blank to
# disable. Personal memory, form values and file contents must never be sent
# here; see docs/privacy.md.
VITE_OPEN_PANEL_KEY=""
