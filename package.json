{
  "name": "ai-form-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-first, local-first browser extension that understands web forms and helps you complete them from a persistent personal memory.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "bun run build:chrome && bun run build:firefox",
    "build:chrome": "wxt zip",
    "build:firefox": "wxt -b firefox zip",
    "dev": "bun dev:chrome",
    "dev:chrome": "wxt",
    "dev:firefox": "wxt -b firefox",
    "dev:site": "bun run scripts/serve-test-site.ts",
    "format": "biome format --write",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "test": "bun test src",
    "test:watch": "bun test src --watch",
    "test:e2e": "bun run build:chrome && playwright test",
    "test:e2e:ui": "bun run build:chrome && playwright test --ui",
    "typecheck": "tsc --noEmit",
    "check": "bun lint && bun typecheck && bun test",
    "prepare": "husky",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@hookform/resolvers": "^5.4.0",
    "@openpanel/web": "^1.4.1",
    "@supabase/supabase-js": "^2.108.1",
    "@tanstack/react-query": "^5.101.0",
    "@webext-core/messaging": "^3.0.2",
    "ai": "^4.3.19",
    "chrome-ai": "^1.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "envin": "^1.2.0",
    "lucide-react": "^1.18.0",
    "next-themes": "^0.4.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.79.0",
    "react-router-dom": "^7.17.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@commitlint/cli": "21.0.2",
    "@commitlint/config-conventional": "21.0.2",
    "@commitlint/types": "21.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.1",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/bun": "^1.3.14",
    "@types/chrome": "0.1.43",
    "@types/node": "25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/auto-icons": "^1.1.1",
    "@wxt-dev/module-react": "1.1.3",
    "husky": "^9.1.7",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "wxt": "^0.20.26"
  }
}
