{
  "name": "fill-my-form",
  "version": "1.5.0",
  "private": true,
  "description": "Privacy-first, local-first browser extension that understands web forms and helps you complete them from a persistent personal memory.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "bun run build:chrome && bun run build:firefox",
    "build:chrome": "wxt zip",
    "build:chrome:e2e": "WXT_E2E=1 wxt zip",
    "build:firefox": "wxt -b firefox --mv3 zip",
    "build:extractor": "bun build --target=browser --format=iife src/lib/form/browser-entry.ts --outfile=build/extractor/extractor.js",
    "dev": "bun dev:chrome",
    "dev:chrome": "bun run scripts/dev-preflight.ts; code=$?; if [ $code -eq 2 ]; then exit 0; elif [ $code -ne 0 ]; then exit $code; fi; wxt",
    "dev:firefox": "wxt -b firefox",
    "dev:fresh": "WXT_DEV_FRESH_PROFILE=1 wxt",
    "dev:site": "bun run scripts/serve-test-site.ts",
    "landing": "cd landing-page && npm run dev",
    "format": "biome format --write",
    "lint": "biome check",
    "check:forbidden-deps": "bun run scripts/check-forbidden-deps.ts",
    "check:generalized-fixtures": "bun run scripts/check-generalized-fixtures.ts",
    "lint:fix": "biome check --write",
    "test": "bun test ./src ./scripts",
    "eval": "bun run scripts/eval.ts",
    "test:watch": "bun test ./src ./scripts --watch",
    "test:e2e": "bun run build:chrome && bun run build:chrome:e2e && bun run build:extractor && playwright test",
    "test:e2e:ui": "bun run build:chrome && bun run build:chrome:e2e && bun run build:extractor && playwright test --ui",
    "goldens:update": "bun run build:extractor && UPDATE_GOLDENS=1 playwright test e2e/extraction.spec.ts && biome format --write e2e/goldens",
    "typecheck": "tsc --noEmit",
    "check": "bun lint && bun typecheck && bun run test && bun run check:forbidden-deps && bun run check:generalized-fixtures",
    "prepare": "husky",
    "postinstall": "wxt prepare",
    "submit:firefox": "bun run scripts/submit-firefox.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@hookform/resolvers": "^5.4.0",
    "@supabase/supabase-js": "^2.108.1",
    "@tanstack/react-query": "^5.101.0",
    "@webext-core/messaging": "^3.0.2",
    "ai": "^4.3.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compressorjs": "^1.3.0",
    "cropperjs": "^2.2.0",
    "envin": "^1.2.0",
    "lucide-react": "^1.18.0",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.79.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "uisfx": "^0.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@commitlint/cli": "21.0.2",
    "@commitlint/config-conventional": "21.0.2",
    "@commitlint/types": "21.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.1",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/bun": "^1.3.14",
    "@types/chrome": "0.1.43",
    "@types/node": "25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@wxt-dev/auto-icons": "^1.1.1",
    "@wxt-dev/module-react": "1.2.2",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "wxt": "^0.20.26"
  },
  "overrides": {
    "@vitejs/plugin-react": "^6.1.1"
  }
}
