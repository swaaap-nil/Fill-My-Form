---
import { siteConfig } from '../lib/config';
import { content } from '../lib/content';
import { firefoxStoreUrl, localizedPath, type Locale } from '../lib/locales';
interface Props {
  locale: Locale;
  placement: 'nav' | 'hero' | 'closing' | 'help';
  small?: boolean;
}
const { locale, placement, small = false } = Astro.props;
const t = content[locale];
const options = [
  siteConfig.chrome && {
    browser: 'chrome',
    href: siteConfig.chrome,
    label: t.install,
    current: true,
  },
  siteConfig.firefox && {
    browser: 'firefox',
    href: firefoxStoreUrl(locale),
    label: 'Firefox',
    current: false,
  },
].filter(Boolean) as {
  browser: 'chrome' | 'firefox';
  href: string;
  label: string;
  current: boolean;
}[];
const fallbackHref = localizedPath(locale, 'help');
---

{
  options.length ? (
    <div
      class:list={['install-options', { 'install-options-small': small }]}
      data-install-options
      data-placement={placement}
    >
      {options.map((option) => (
        <a
          class:list={[
            'button',
            option.current ? 'button-primary' : 'button-secondary',
            'install-option',
            `install-option-${option.browser}`,
            {
              'install-option-current': option.current,
              'button-small': small,
            },
          ]}
          href={option.href}
          data-install={option.browser}
          data-placement={placement}
          data-current-browser={option.current ? 'true' : undefined}
        >
          {option.browser === 'chrome' ? (
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
              data-browser-icon="chrome"
            >
              <circle
                cx="12"
                cy="12"
                r="9"
                stroke="currentColor"
                stroke-width="1.5"
              />
              <circle
                cx="12"
                cy="12"
                r="4"
                stroke="currentColor"
                stroke-width="1.5"
              />
              <path
                d="M12 8h8M8.5 14 4.5 7M14 15.5 10 21"
                stroke="currentColor"
                stroke-width="1.5"
              />
            </svg>
          ) : (
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
              data-browser-icon="firefox"
            >
              <path
                d="M6.5 6.5c1.1-1.5 2.8-2.5 5.2-2.5 4.8 0 8.3 3.5 8.3 8s-3.5 8-8.3 8C7.2 20 4 16.8 4 12.5c0-2.3 1-4.3 2.5-6Z"
                stroke="currentColor"
                stroke-width="1.5"
              />
              <path
                d="M8 5c-.2 1.8.4 3.3 1.6 4.4M5.1 9.3c1.8-.8 3.7-.3 5 1.3 1 1.2 2.5 1.4 3.8.7"
                stroke="currentColor"
                stroke-width="1.5"
              />
              <path
                d="M16.5 5.5c.2 2.8-1.2 4.7-4.1 5.7M8.2 15.2c1.8 2 5.5 2.1 7.4-.2"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
              />
            </svg>
          )}
          <span class="install-option-label">{option.label}</span>
          <span class="arrow" aria-hidden="true">
            ↗
          </span>
        </a>
      ))}
    </div>
  ) : (
    <a
      class:list={['button', 'button-primary', { 'button-small': small }]}
      href={fallbackHref}
      data-placement={placement}
    >
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        aria-hidden="true"
        data-browser-icon="chrome"
      >
        <circle
          cx="12"
          cy="12"
          r="9"
          stroke="currentColor"
          stroke-width="1.5"
        />
        <circle
          cx="12"
          cy="12"
          r="4"
          stroke="currentColor"
          stroke-width="1.5"
        />
        <path
          d="M12 8h8M8.5 14 4.5 7M14 15.5 10 21"
          stroke="currentColor"
          stroke-width="1.5"
        />
      </svg>
      <span class="install-option-label">{t.install}</span>
      <span class="arrow" aria-hidden="true">
        ↗
      </span>
    </a>
  )
}
