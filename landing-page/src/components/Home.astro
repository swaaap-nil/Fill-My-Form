---
import Mark from './Mark.astro';
import Install from './Install.astro';
import { content } from '../lib/content';
import { localizedPath, type Locale } from '../lib/locales';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = content[locale];
const fields = [
  [t.name, 'Alex Morgan'],
  [t.email, 'alex@example.com'],
  [t.location, 'Lisbon'],
  [t.experience, t.experienceValue],
];
---

<section class="hero shell">
  <div class="eyebrow hero-eyebrow">
    <span class="status-dot"></span>{t.tagline}
  </div>
  <h1>{t.hero1}<br /><span class="gradient-text">{t.hero2}</span></h1>
  <p class="hero-description">{t.description}</p>
  <div class="hero-actions">
    <Install locale={locale} placement="hero" /><a
      class="button button-quiet"
      href="#how">{t.secondary}<span aria-hidden="true">↓</span></a
    >
  </div>
  <p class="trust-line">
    <svg
      width="14"
      height="16"
      viewBox="0 0 16 18"
      fill="none"
      aria-hidden="true"
      ><path
        d="m8 1 6 3v5c0 4-6 7-6 7S2 13 2 9V4l6-3Z"
        stroke="currentColor"
        stroke-width="1.4"></path><path
        d="m5 8 2 2 4-4"
        stroke="currentColor"
        stroke-width="1.4"></path></svg
    >{t.trustLine}
  </p>
  <svg class="hero-thread" viewBox="0 0 1100 150" fill="none" aria-hidden="true"
    ><defs
      ><linearGradient id="thread"
        ><stop stop-color="#5863ff"></stop><stop offset="1" stop-color="#ee82c4"
        ></stop></linearGradient
      ></defs
    ><path
      d="M-20 125C130 130 90 12 212 30S290 163 396 82 505 40 548 76 590 129 643 65 736 32 779 70 907 113 1120 5"
      stroke="url(#thread)"
      stroke-width="2"></path></svg
  >
  <div class="demo-caption">
    <span aria-hidden="true">↙</span>{t.previewLabel}
  </div>
  <div class="product-preview" data-demo>
    <div class="preview-bar">
      <span class="window-dots" aria-hidden="true"><i></i><i></i><i></i></span
      ><span class="preview-brand"><Mark />Fill My Form</span><span
        class="preview-local"
        ><span class="status-dot"></span>{t.profileNote}</span
      >
    </div>
    <div class="preview-content">
      <aside class="memory-panel">
        <div class="memory-icon" aria-hidden="true">✳</div><h2>
          {t.profile}
        </h2><p>{t.profileNote}</p><div class="profile-person">
          <div class="avatar" aria-hidden="true">AM</div><div>
            <strong>Alex Morgan</strong><small>{t.saved}</small>
          </div><span class="check" aria-hidden="true">✓</span>
        </div><div class="memory-tags">
          {
            fields.slice(0, 3).map(([label]) => (
              <span>
                <span aria-hidden="true">✓</span> {label}
              </span>
            ))
          }
        </div><div class="memory-bottom">
          <svg
            width="16"
            height="16"
            viewBox="0 0 16 16"
            fill="none"
            aria-hidden="true"
            ><rect
              x="3"
              y="7"
              width="10"
              height="7"
              rx="2"
              stroke="currentColor"></rect><path
              d="M5 7V5a3 3 0 0 1 6 0v2"
              stroke="currentColor"></path></svg
          >{t.trustLine}
        </div>
      </aside>
      <div class="demo-form">
        <div class="form-heading">
          <div>
            <span class="mini-label">01 — 04</span><h2>{t.application}</h2>
          </div><span class="form-emblem" aria-hidden="true">↗</span>
        </div><div class="demo-fields">
          {
            fields.map(([label, value], i) => (
              <div class:list={['demo-field', { 'full-field': i === 3 }]}>
                <>
                  <span class="field-label">{label}</span>
                  <div class="fake-input">
                    <>
                      <span data-demo-value={value} class="demo-value">
                        {value}
                      </span>
                      <span class="input-skeleton" aria-hidden="true" />
                      <span class="field-check" aria-hidden="true">
                        ✓
                      </span>
                    </>
                  </div>
                </>
              </div>
            ))
          }
        </div><div class="demo-controls">
          <button
            type="button"
            class="button demo-button"
            data-fill
            data-fill-label={t.fillDemo}
            data-reset-label={t.reset}
            ><span aria-hidden="true">✳</span><span data-fill-text
              >{t.fillDemo}</span
            ></button
          ><span
            class="demo-status"
            role="status"
            data-demo-status
            data-empty={t.empty}
            data-filled={t.filled}>{t.empty}</span
          >
        </div>
      </div>
    </div>
    <p class="illustration-note">{t.illustrative}</p>
  </div>
</section>
<section id="how" class="paper-section">
  <div class="shell">
    <div class="section-intro">
      <p class="eyebrow">{t.howLabel}</p><h2>{t.howTitle}</h2>
    </div><div class="steps-grid">
      {
        t.steps.map(([title, body], i) => (
          <article>
            <>
              <span class="step-icon" aria-hidden="true">
                {['↳', '✳', '✓'][i]}
              </span>
              <span class="step-number">0{i + 1}</span>
              <h3>{title}</h3>
              <p>{body}</p>
            </>
          </article>
        ))
      }
    </div>
  </div>
</section>
<section id="uses" class="uses-section paper-section">
  <div class="shell">
    <div class="section-intro left-intro">
      <p class="eyebrow">{t.usesLabel}</p><h2>{t.usesTitle}</h2>
    </div><div class="uses-grid">
      {
        t.uses.map(([title, body], i) => (
          <article class={`use-card use-${i}`}>
            <>
              <div class="use-art" aria-hidden="true">
                <>
                  <div class="art-sheet">
                    <>
                      <span>{['↗', '✳', '⌁'][i]}</span>
                      <i />
                      <i />
                      <i />
                      <b>✓</b>
                    </>
                  </div>
                  <span class="art-orbit" />
                </>
              </div>
              <div class="use-copy">
                <>
                  <span class="mini-label">0{i + 1}</span>
                  <h3>{title}</h3>
                  <p>{body}</p>
                </>
              </div>
            </>
          </article>
        ))
      }
    </div>
  </div>
</section>
<section class="privacy-section shell">
  <div class="privacy-art" aria-hidden="true">
    <div class="privacy-orbit orbit-one"></div><div
      class="privacy-orbit orbit-two"
    >
    </div><div class="shield">
      <svg width="98" height="116" viewBox="0 0 98 116" fill="none"
        ><path
          d="m49 5 39 15v36c0 29-39 51-39 51S10 85 10 56V20L49 5Z"
          stroke="currentColor"
          stroke-width="3"></path><path
          d="m31 55 13 13 25-28"
          stroke="currentColor"
          stroke-width="4"
          stroke-linecap="round"
          stroke-linejoin="round"></path></svg
      >
    </div><span class="privacy-spark spark-one">✳</span><span
      class="privacy-spark spark-two">+</span
    >
  </div><div>
    <p class="eyebrow">{t.privacyLabel}</p><h2>{t.privacyTitle}</h2><p
      class="section-body"
    >
      {t.privacyBody}
    </p><a class="text-link" href={localizedPath(locale, 'privacy')}
      >{t.privacyLink}<span aria-hidden="true">↗</span></a
    >
  </div>
</section>
<section class="faq-section paper-section">
  <div class="shell faq-grid">
    <h2>{t.faqsTitle}</h2><div>
      {
        t.faqs.map(([question, answer]) => (
          <details>
            <>
              <summary>
                {question}
                <span aria-hidden="true">+</span>
              </summary>
              <p>{answer}</p>
            </>
          </details>
        ))
      }
    </div>
  </div>
</section>
<section class="closing shell">
  <span class="closing-spark" aria-hidden="true">✳</span><h2>
    {t.closingTitle}
  </h2><p>{t.closingBody}</p><Install locale={locale} placement="closing" />
</section>
