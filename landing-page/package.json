{
  "name": "landing-page",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4321",
    "build": "astro build && node scripts/postbuild.mjs",
    "preview": "wrangler dev",
    "astro": "astro",
    "check": "astro check",
    "test": "node --experimental-strip-types --test tests/unit.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests scripts astro.config.mjs playwright.config.ts",
    "deploy:preview": "node scripts/deploy.mjs",
    "deploy:production": "node scripts/deploy.mjs --production",
    "build:production": "SITE_ENV=production npm run build"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.0",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.1",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "lighthouse": "^13.4.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.129.0"
  }
}
